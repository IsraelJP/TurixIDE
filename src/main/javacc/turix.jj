options {
  STATIC = false;
  UNICODE_INPUT = true;
}

PARSER_BEGIN(Turix)
package com.turix.TurixCC;

import codigo_intermedio.QuadGenerator;
import codigo_intermedio.QuadPrinter;
import codigo_intermedio.VariableContext;
import Semantico.TokenAsignaciones;
import Semantico.erroresSem;

import java.util.ArrayList;
import java.util.List;

public class Turix {

  // ===== Bloques de código intermedio ya formateados =====
  private final List<String> quadBlocks = new ArrayList<>();
  private final VariableContext varContext = new VariableContext();

  public VariableContext getVarContext() {
    return varContext;
  }

  /** Devuelve y NO limpia (la GUI decide). */
  public List<String> getQuadBlocks() {
    return quadBlocks;
  }

  /** Emite un bloque de cuádruplas para var = exprInfija (formateado como en la consola). */
  // === Helper para emitir bloque de código intermedio ===
    void emitQuad(String var, String exprInfija) {
        // Genera quads + evalúa en tiempo de compilación con el contexto actual
        QuadGenerator.Result r = QuadGenerator.fromAssignment(var, exprInfija, varContext.getAll());

        // Detectar tipo declarado del lado izquierdo desde la tabla semántica
        Integer tipoL = (Integer) Semantico.TokenAsignaciones.tabla.get(var);

        Double overrideEval = null;
        Double toStore = null;

        if (r.eval != null) {
            // Por defecto guardamos el double evaluado
            toStore = r.eval;

            // Si el destino es INT, truncamos hacia 0 tanto el mostrado como el almacenado
            if (tipoL != null && tipoL == TurixConstants.INT) {
                int entero = (int) (r.eval.doubleValue());
                overrideEval = (double) entero;
                toStore = overrideEval;
            }
        }

        // Imprimir bloque, usando el override si aplica
        String block = QuadPrinter.formatBlock(quadBlocks.size() + 1, var, exprInfija, r, overrideEval);
        quadBlocks.add(block);

        // Actualiza contexto de variables para evaluación posterior
        if (toStore != null) {
            varContext.set(var, toStore);
        }
    }


  // ===== Buffer para reconstruir la expresión INFija mientras se parsea =====
  private final StringBuilder exprBuffer = new StringBuilder();

  void exprBufClear() { exprBuffer.setLength(0); }
  String exprBufGet() { return exprBuffer.toString().trim(); }

  void emitTok(Token tok) {
    if (tok != null && tok.image != null) {
      // System.out.println("emitTok: " + tok.image); // DEBUG opcional
      exprBuffer.append(tok.image).append(' ');
    }
  }

  void emitText(String s) {
    if (s != null && !s.isEmpty()) {
      exprBuffer.append(s).append(' ');
    }
  }
}
PARSER_END(Turix)

SKIP : {
  " " | "\t" | "\r" | "\n"
}

TOKEN : {

    < NUM:( (["0"-"9"])+ )>
  | < NUM_DEC:(( ["0"-"9"] )+ ( "." (["0"-"9"])+ ) )>
  | <STRING_LITERAL :
        // String multilínea
        "\"\"\"" (~["\""] | "\"" | "\"\"")* "\"\"\""
      |
        // String normal de una línea
        "\"" ( "\\" | ~["\"","\\","\n","\r"] )* "\""
    >

  // OPERADORES MATEMÁTICOS
  | < MAS: "+" >
  | < MENOS: "-" >
  | < MULTIPLICACION: "*" >
  | < DIVISION: "/" >
  | < MODULO: "%" >
  | < DOUBLE: "Double" >
  | < IGUAL: "=" >
  | < SQRT: "sqrt" >
  | < POW: "pow" >
  | < COS: "cos" >
  | < SIN: "sin" >
  | < LOG: "log" >

  // TIPOS DE DATO
  | < INT: "Int" >
  | < FLOAT: "Float" >
  | < STRING: "String" >
  | < BOOL: "Bool" >
  | < CHARACTER: "Character" >

  // OPERADORES LÓGICOS
  | < AND: "&&" >
  | < NOT: "!" >
  | < OR: "||" >

  // RELACIONALES
  | < REL_OP : "==" | "!=" | ">=" | "<=" | ">" | "<" >

  // Símbolos
  | < DOS_PUN: ":" >
  | < FLECHA : "->" >
  | < COMILLA : "\"" >
  | < COMA : "," >

  // Palabras reservadas
  | < FUNC: "func" >
  | < LET: "let" >
  | < VAR: "var" >
  | < TERMINATOR: "terminator" >
  | < SEPARATOR: "separator" >
  | < PRINT: "print" >
  | < READLINE: "readLine" >

  // Control de flujo
  | < BREAK: "break" >
  | < CASE: "case" >
  | < DEFAULT_KEYWORD: "default" >
  | < REPEAT: "repeat" >
  | < ELSE: "else" >
  | < FOR: "for" >
  | < IF: "if" >
  | < IN: "in" >
  | < RETURN: "return" >
  | < SWITCH: "switch" >
  | < WHERE: "where" >
  | < WHILE: "while" >

  // Paréntesis/llaves/corchetes
  | < K_I: "{" >
  | < K_F: "}" >
  | < PAR_I: "(" >
  | < PAR_F: ")" >
  | < COR_I: "[" >
  | < COR_F: "]" >

  // Literales booleanos
  | < FALSE: "false" >
  | < TRUE: "true" >

  // IDENTIFICADOR
  | < IDENT : "`" ( ["A"-"Z","a"-"z","0"-"9","_"] )+ "`"
    | ( ["A"-"Z","a"-"z","_"] ) ( ["A"-"Z","a"-"z","0"-"9","_"] )* >

  // ERRORES
  | < ERROR: (["0"-"9"])+ ("." (["0"-"9"])+){2,} >
  | < ERROROPERA:  "=!" | "=>" | "=<" >
  | < ERROR_IDENT :
      (["A"-"Z","a"-"z","_"])(["A"-"Z","a"-"z","0"-"9","_"])*
      (~["A"-"Z","a"-"z","0"-"9","_"," ","\t","\r","\n",
        "!","\"","%","(",")","*","+",",","-","/",":",
        "=","[","]","{","}","&","|","?",">","<"])
      (["A"-"Z","a"-"z","0"-"9","_"])*
      |
      (~["A"-"Z","a"-"z","_"," ","\t","\r","\n",
        "!","\"","%","(",")","*","+",",","-","/",":",
        "=","[","]","{","}","&","|","?",">","<","0"-"9"])+
    >
}

// =============================
// CUERPO DEL PROGRAMA
// =============================
void Start() :
{
    TokenAsignaciones.SetTables();
}
{
    {
      // limpiar bloques de compilaciones previas (por si reusan el parser)
      this.getQuadBlocks().clear();
    }
    ListaSentencias() <EOF>
}

void ListaSentencias() :
{}
{
    ( Sentencia() )*
}

void Sentencia() :
{}
{
     DeclaracionVar()
   | DeclaracionLet()
   | DeclaracionIF()
   | Func()
   | RetornoSentencia()
   | Imprimir()
   | SentenciaRepeat()
   | LOOKAHEAD(2) LlamadoFunc()
   | Asignacion()
   | Switch()
   | SentenciaWhile()
   | Exp(null)
}

// =============================
// DECLARACIONES / CONTROL
// =============================

// IF
void DeclaracionIF() :
{}
{
    <IF> Condicion() <K_I> ListaSentencias() <K_F> (LOOKAHEAD(2) DecElse()| LOOKAHEAD(2) ElseIf())?
}

void DecElse() :
{}
{
    <ELSE> <K_I> ListaSentencias() <K_F>
}

void ElseIf():
{}
{
     <ELSE> <IF> Condicion() <K_I> ListaSentencias() <K_F> (LOOKAHEAD(2) DecElse()| LOOKAHEAD(2) ElseIf())?
}

// SWITCH
void Switch():
{}
{
    <SWITCH> { exprBufClear(); } Exp(null) <K_I> (Case())* (DefaultCase())? <K_F>
}
void Case():
{}
{
    { exprBufClear(); } <CASE> Exp(null) <DOS_PUN> ListaSentencias()
}

void DefaultCase():
{}
{
    <DEFAULT_KEYWORD> <DOS_PUN> ListaSentencias()
}

// REPEAT
void SentenciaRepeat():
{}
{
    <REPEAT> <K_I> ListaSentencias() <K_F> <WHILE> Condicion()
}

// WHILE
void SentenciaWhile() :
{}
{
    <WHILE> Condicion() <K_I> ListaSentencias() <K_F>
}

// =============================
// VAR / LET
// =============================

// VAR (con inicialización opcional)
void DeclaracionVar() :
{ Token id=null; Token tipo=null; Token expTok=null; }
{
    <VAR> id=<IDENT> ( <DOS_PUN> tipo=Tipo() )?
    (
      <IGUAL>
      {
        exprBufClear();
      }
      expTok=Exp(null)
      {
         // Inserta símbolo antes de validar
         Semantico.TokenAsignaciones.InsertarSimbolo(id, (tipo != null ? tipo.kind : TurixConstants.INT), null);

         // Valida semántica y condiciona la generación
         int __semBefore = erroresSem.getErrores().size();
         Semantico.TokenAsignaciones.checkAsing(id, exprBufGet());
         if (erroresSem.getErrores().size() == __semBefore) {
             emitQuad(id.image, exprBufGet());
         }
      }
    )?
    {
      // Si no hubo asignación, solo declara
      if (expTok == null) {
         Semantico.TokenAsignaciones.InsertarSimbolo(id, (tipo != null ? tipo.kind : TurixConstants.INT), null);
      }
    }
}


// LET (con inicialización opcional)
void DeclaracionLet() :
{ Token id=null; }
{
    <LET> id=<IDENT> ( <DOS_PUN> Tipo() )?
    ( <IGUAL> { exprBufClear(); } Exp(null) { emitQuad(id.image, exprBufGet()); } )?
}

void ListaLet():
{}
{
  DeclaracionLet() (<COMA> DeclaracionLet())*
}

// ASIGNACIÓN
void Asignacion() :
{ Token izq=null; }
{
    izq=<IDENT>
    <IGUAL>
    {
        exprBufClear();
    }
    Exp(null)
    {
        // Valida semántica y condiciona generación
        int __semBefore = erroresSem.getErrores().size();
        Semantico.TokenAsignaciones.checkAsing(izq, exprBufGet());
        if (erroresSem.getErrores().size() == __semBefore) {
            emitQuad(izq.image, exprBufGet());
        }
        // else: hubo error semántico -> no generes cuádruplas de esta asignación
    }
}


// =============================
// CONDICIÓN
// =============================
void Condicion() :
{}
{
   ( { exprBufClear(); } Exp(null) (<REL_OP> { exprBufClear(); } Exp(null) ((<AND> | <OR> | <NOT>)  (CondicionAnidada()|{ exprBufClear(); }Exp(null)) (<REL_OP> { exprBufClear(); } Exp(null))? )* )? ) | ListaLet()
}

void CondicionAnidada():
{}
{
  <PAR_I> Condicion() <PAR_F>
}

// =============================
// TIPOS
// =============================
Token Tipo() :
{
  Token t = null;
}
{
      t=<INT>      { return t; }
    | t=<FLOAT>    { return t; }
    | t=<STRING>   { return t; }
    | t=<BOOL>     { return t; }
    | t=<DOUBLE>   { return t; }
}

// =============================
// OPERADORES (no usada para armar infija)
// =============================
void Operadores():
{}
{
  <MAS> | <MENOS> | <MULTIPLICACION> | <DIVISION> | <MODULO>
}

// =============================
// FUNCIONES
// =============================
void funcionesDefinidas():
{}
{
   <SQRT> | <POW> | <COS> | <SIN> | <LOG> | <READLINE>
}

void Func() :
{}
{
    <FUNC> <IDENT> <PAR_I> (Parametros())? <PAR_F> (Retorno())? <K_I> ListaSentencias() <K_F>
}

void LlamadoFunc():
{}
{
   ( <IDENT> | funcionesDefinidas() | Tipo() ) <PAR_I> (ListaExp())? <PAR_F>
}

void ParametroLlamadaFun():
{ Token izq; Token der; }
{
  izq=<IDENT> <DOS_PUN> { exprBufClear(); } der=Exp(izq) {
    TokenAsignaciones.checkAsing(izq, exprBufGet());
  }
}

// RETURN
void Retorno() :
{}
{
   <FLECHA> Tipo()
}

void RetornoSentencia():
{}
{
   <RETURN> { exprBufClear(); } Exp(null)
}

// PRINT
void Imprimir():
{}
{
   <PRINT> <PAR_I> ListaExpPrint() <PAR_F>
}

void ListaExpPrint():
{}
{
    { exprBufClear(); }
    Exp(null)
    {
        String expr = exprBufGet().trim();

        // Solo generar cuádruplos si NO es literal de texto
        if (!(expr.startsWith("\"") && expr.endsWith("\""))) {
            emitQuad("_resultado_print", expr);
        }
    }
    (
      <COMA>
      (
        { exprBufClear(); }
        Exp(null)
        {
            String expr2 = exprBufGet().trim();
            if (!(expr2.startsWith("\"") && expr2.endsWith("\""))) {
                emitQuad("_resultado_print", expr2);
            }
        }
        | Opcion_Print()
      )
    )*
}


void Opcion_Print():
{}
{
    (  <TERMINATOR> <DOS_PUN> { exprBufClear(); } Exp(null) )
  | (  <SEPARATOR>  <DOS_PUN> { exprBufClear(); } Exp(null) )
}

// =============================
// PARÁMETROS
// =============================
void Parametros() :
{}
{
   Parametro() (<COMA> Parametro())*
}

void Parametro() :
{ Token id; Token tipo; }
{
   id=<IDENT> <DOS_PUN> tipo=Tipo() {
     TokenAsignaciones.InsertarSimbolo(id, tipo != null ? tipo.kind : TurixConstants.INT, null);
   }
}

// =============================
// LISTAS / EXPRESIONES
// =============================
void ListaExp():
{}
{
    Exp(null) (<COMA> Exp(null))*
}

// ===== Termino (agrega al buffer) =====
Token Term() :
{ Token t = null; }
{
    t=<NUM>                 { emitTok(t); return t; }
  | t=<NUM_DEC>             { emitTok(t); return t; }
  | LOOKAHEAD(2) LlamadoFunc()
      {
        emitText("call");
        Token fake = new Token();
        fake.kind = TurixConstants.IDENT; // un tipo no-literal para compatibilidad
        fake.image = "call";
        return fake;
      }
  | LOOKAHEAD(2) ParametroLlamadaFun()
      {
        emitText("param");
        Token fake = new Token();
        fake.kind = TurixConstants.IDENT;
        fake.image = "param";
        return fake;
      }
  | t=<IDENT> {
      String msg = TokenAsignaciones.checkVariable(t);
      if (!msg.equals(" ")) {
          erroresSem.addError(msg);
      }
      emitTok(t);
      return t;
    }
  | t=<TRUE>                { emitTok(t); return t; }
  | t=<FALSE>               { emitTok(t); return t; }
  | t=<STRING_LITERAL>      { emitTok(t); return t; }
}

// ===== Expresión (construye INFija en exprBuffer) =====
Token Exp(Token iden) :
{
    Token t = null;      // primer término
    Token temp = null;   // último término/expresión consumido a la derecha
    Token op = null;
}
{
    ( <MENOS> { emitText("-"); } )?
    t=Term()
    {
        // Si el primer término es IDENT, conserva en 'iden' si te sirve en otros lugares.
        if (t.kind == TurixConstants.IDENT) {
            iden = t;
        }
    }
    (
      ( op=<MAS> | op=<MENOS> | op=<MULTIPLICACION> | op=<DIVISION> | op=<MODULO> )
      {
        // INFija: escribe el operador ANTES de consumir el operando derecho
        emitTok(op);
      }
      (
          // Term() y sus subreglas deben encargarse de empujar sus lexemas al exprBuffer
          temp=Term()
        | <PAR_I> { emitText("("); } temp=Exp(null) <PAR_F> { emitText(")"); }
      )
    )*
    {
        // Devuelve el último token consumido si existe; si no, el primero (compatibilidad)
        return (temp != null ? temp : t);
    }
}
